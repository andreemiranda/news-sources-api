{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-sources-api",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".next",
    "binding": "ASSETS"
  },
  "vars": {
    "AI_API_KEY": "default",
    "AI_ENDPOINT": "default",
    "AI_MODEL": "default",
    "G1_REPLACEMENT": "Portal de Notícias",
    "SOURCE_OWNER_REPLACEMENT": "Portal Norma Jurídica",
    "SOURCE_OWNER_REPLACEMENTS": "{\"G1\":\"Portal Norma Jurídica\",\"CNN Brasil\":\"Portal Norma Jurídica\",\"Cleber Toledo\":\"Portal Norma Jurídica\",\"Atitude TO\":\"Portal Norma Jurídica\",\"PMW Notícias\":\"Portal Norma Jurídica\",\"Gazeta do Cerrado\":\"Portal Norma Jurídica\",\"Voz do Bico\":\"Portal Norma Jurídica\",\"Portal do Bico\":\"Portal Norma Jurídica\",\"Folha do Bico\":\"Portal Norma Jurídica\",\"Bico 24 Horas\":\"Portal Norma Jurídica\",\"Guaraiense\":\"Portal Norma Jurídica\",\"Jornal O Bico\":\"Portal Norma Jurídica\",\"Opinião Goiás\":\"Portal Norma Jurídica\",\"Portal Notícias Goiás\":\"Portal Norma Jurídica\",\"Diário de Goiás\":\"Portal Norma Jurídica\",\"Nação Jurídica\":\"Portal Norma Jurídica\",\"Conjur\":\"Portal Norma Jurídica\",\"Meu Site Jurídico\":\"Portal Norma Jurídica\",\"INW\":\"Portal Norma Jurídica\",\"Âmbito Jurídico\":\"Portal Norma Jurídica\",\"Justa\":\"Portal Norma Jurídica\",\"O Direito\":\"Portal Norma Jurídica\",\"Rota Jurídica\":\"Portal Norma Jurídica\",\"Exame\":\"Portal Norma Jurídica\",\"Gazeta Esportiva\":\"Portal Norma Jurídica\",\"Ludopédio\":\"Portal Norma Jurídica\",\"Você S/A\":\"Portal Norma Jurídica\",\"Folha Destra\":\"Portal Norma Jurídica\",\"Minhas Economias\":\"Portal Norma Jurídica\",\"Info Educação\":\"Portal Norma Jurídica\",\"Santa Catarina em Pauta\":\"Portal Norma Jurídica\",\"Canal do G1\":\"Canal do Portal Portal Norma Jurídica\",\"Whatsapp do G1\":\"Whatsapp do Portal Portal Norma Jurídica\",\"Instagram do G1\":\"Instagram do Portal Portal Norma Jurídica\"}"
  }
}
