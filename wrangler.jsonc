  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_BASE_URL": "https://news-sources-api.mirandinhacontabilidade.workers.dev",
    "API_KEY": "bn_88feb5baa3f84955677e8c11453aae352811b9fe6c3398cd"
  }
}
